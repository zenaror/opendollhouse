+
+using System;
+using System.Collections.Generic;
+using FSO.Files.Formats.IFF.Chunks;
+
+namespace FSO.SimAntics.Utils
+{
+    /// <summary>
+    /// Computes the code closure signature observed at VA 0x00402741 in the
+    /// supplied native profile with SHA256
+    /// 6e598c22512a24659cbd0e533306abf3129733d67b1d120916b1b6b1581e29f2.
+    /// The native algorithm reads the full uint32 header word at +8, including
+    /// its reserved high 16 bits, represented by BHAV.NativeVersionWord.
+    /// This helper defines no saved-object reset or migration policy.
+    /// </summary>
+    public static class VMTS1CodeSignature
+    {
+        /// <summary>
+        /// Resolves each reachable tree ID once, including missing dependencies.
+        /// The caller supplies the global/private/semiglobal resolution context.
+        /// </summary>
+        public static uint Compute(ushort rootId, Func<ushort, BHAV> resolve)
+        {
+            if (resolve == null) throw new ArgumentNullException(nameof(resolve));
+            var root = resolve(rootId);
+            if (root == null) return 0;
+
+            var pending = new Stack<ushort>();
+            var visited = new HashSet<ushort>();
+            pending.Push(rootId);
+            if (!root.NativeVersionWord.HasValue)
+                throw new NotSupportedException("The root BHAV has no supported native version word.");
+            uint signature = root.NativeVersionWord.Value << 16;
+
+            unchecked
+            {
+                while (pending.Count != 0)
+                {
+                    var id = pending.Pop();
+                    if (!visited.Add(id)) continue;
+                    var tree = id == rootId ? root : resolve(id);
+                    if (tree == null) continue;
+
+                    if (!tree.NativeVersionWord.HasValue)
+                        throw new NotSupportedException("A reachable BHAV has no supported native version word: " + id);
+                    signature += tree.NativeVersionWord.Value;
+                    foreach (var instruction in tree.Instructions)
+                    {
+                        var opcode = (ushort)(instruction.Opcode & 0x7fff);
+                        if (opcode > 255) pending.Push(opcode);
+                    }
+                }
+            }
+
+            return signature;
+        }
+    }
+}
