+        /// <summary>
+        /// Evict only user-character definitions before neighborhood reload.
+        /// Removing GUID wrappers alone leaves their mutable IFF resources in
+        /// ProcessedFiles, so a later Get could resurrect discarded changes.
+        /// Global/FAR/download objects and catalog indexes remain registered.
+        /// </summary>
+        public void ClearUserCharacters()
+        {
+            if (Entries == null) return;
+            KeyValuePair<ulong, GameObjectReference>[] characters;
+            lock (Entries)
+                characters = Entries.Where(entry => entry.Value.Source == GameObjectSource.User).ToArray();
+
+            foreach (var character in characters)
+            {
+                RemoveObject((uint)character.Key);
+                PersonGUIDs.Remove((uint)character.Key);
+            }
+            foreach (var filename in characters.Select(character => character.Value.FileName).Distinct(StringComparer.Ordinal))
+            {
+                GameObjectResource removed;
+                ProcessedFiles.TryRemove(filename, out removed);
+            }
+        }
