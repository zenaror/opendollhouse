+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using FSO.LotView.Model;
+using FSO.SimAntics.Engine;
+using FSO.SimAntics.Model;
+using FSO.Vitaboy;
+using Microsoft.Xna.Framework;
+
+namespace FSO.SimAntics.Utils
+{
+    /// <summary>
+    /// One import's cXPerson reset/notification adapter (native 0045e8fd).
+    /// Owns mutable execution metadata because OBJM use boundaries and the raw
+    /// active icon are not represented by VMThread's ordinary action model.
+    /// The caller owns world notifications, referenced-object reset dispatch,
+    /// and the final incompatibility Init. This class never calls Init/Reset.
+    /// </summary>
+    public sealed class VMTS1PersonRecovery
+    {
+        private readonly VM VM;
+        private readonly VMTS1SavedCodeCompatibility Plan;
+        private readonly Action<VMEntity> ResetReferencedObject;
+        private readonly Dictionary<short, PersonState> People = new Dictionary<short, PersonState>();
+        private readonly HashSet<short> Resetting = new HashSet<short>();
+
+        /// <summary>
+        /// Semantic equivalent of native target+114 bit12: suppress cascading
+        /// referenced-object resets while still unwinding the person's uses.
+        /// It is an internal reset policy, not an ObjectData/VMEntityFlags bit.
+        /// The predicate receives the notification target, or the person for SELF.
+        /// </summary>
+        public Func<VMEntity, bool> SuppressReferencedObjectReset { get; set; }
+
+        public VMTS1PersonRecovery(VM vm, VMTS1SavedCodeCompatibility plan,
+            Action<VMEntity> resetReferencedObject)
+        {
+            VM = vm ?? throw new ArgumentNullException(nameof(vm));
+            Plan = plan ?? throw new ArgumentNullException(nameof(plan));
+            ResetReferencedObject = resetReferencedObject ?? throw new ArgumentNullException(nameof(resetReferencedObject));
+        }
+
+        private sealed class PersonState
+        {
+            public readonly List<VMTS1SavedPersonRecoveryState.ObjectUse> Uses;
+            public VMQueuedAction ActiveAction;
+            public short ActiveTarget;
+            public short ActiveIcon;
+            public short LastTarget;
+            public short LastIcon;
+
+            public PersonState(VMAvatar person, VMTS1SavedPersonRecoveryState saved)
+            {
+                Uses = saved.ObjectUses.ToList();
+                ActiveTarget = saved.ActiveInteraction.TargetID;
+                ActiveIcon = saved.ActiveInteraction.Icon;
+                LastTarget = saved.LastInteraction.TargetID;
+                LastIcon = saved.LastInteraction.Icon;
+                // Native queued interactions exclude the active interaction;
+                // the runtime importer places a valid active interaction at 0.
+                if (saved.ActiveInteraction.IsValid && person.Thread.Queue.Count != 0)
+                    ActiveAction = person.Thread.Queue[0];
+            }
+        }
+
+        private static NotSupportedException Unsupported(VMAvatar person, string reason)
+        {
+            return new NotSupportedException("TS1 person recovery unsupported for avatar "
+                + (person?.ObjectID ?? 0) + ": " + reason);
+        }
+
+        /// <summary>Preflight without executing BHAVs or changing VM state.</summary>
+        public void Validate(VMAvatar person)
+        {
+            if (person == null) throw new ArgumentNullException(nameof(person));
+            if (!VM.TS1) throw Unsupported(person, "the adapter requires TS1");
+            if (person.Dead || person.GhostImage || person.Object?.OBJ == null
+                || !ReferenceEquals(VM.GetObjectById(person.ObjectID), person)
+                || person.Thread?.Stack == null || person.Thread.Queue == null
+                || person.ObjectData == null || person.ObjectData.Length < 72
+                || person.EntryPoints == null || person.EntryPoints.Length <= 10
+                || person.Contained == null || person.Animations == null
+                || person.GetPersonDataClone().Length < 74
+                || person.MultitileGroup == null || person.MultitileGroup.Objects.Count != 1
+                || person.MultitileGroup.Objects[0] != person)
+                throw Unsupported(person, "missing execution/data state, dead/ghost state, or grouped avatar");
+            if (person.Thread.ActiveQueueBlock < -1 || person.Thread.ActiveQueueBlock >= person.Thread.Queue.Count)
+                throw Unsupported(person, "invalid active queue boundary");
+            if (person.Thread.Queue.Any(action => action == null || action.Callback != null))
+                throw Unsupported(person, "a null action or non-native action callback cannot be discarded as an OBJM interaction");
+            var parent = person.Container;
+            if (parent != null && (person.ContainerSlot < 0 || person.ContainerSlot >= parent.TotalSlots()
+                || parent.GetSlot(person.ContainerSlot) != person))
+                throw Unsupported(person, "inconsistent container slot");
+            foreach (var child in person.Contained)
+                if (child != null && (child.Container != person || child.ContainerSlot < 0
+                    || child.ContainerSlot >= person.Contained.Length || person.Contained[child.ContainerSlot] != child))
+                    throw Unsupported(person, "inconsistent carried-object slot");
+
+            PersonState current;
+            if (People.TryGetValue(person.ObjectID, out current)) return;
+            var saved = Plan.GetPersonState(person.ObjectID);
+            if (saved == null) throw Unsupported(person, "native saved ObjectUses/active-icon metadata was not captured");
+            var previousDepth = 0;
+            foreach (var use in saved.ObjectUses)
+            {
+                if (use.StackLength < 1 || use.StackLength < previousDepth || use.StackLength > person.Thread.Stack.Count)
+                    throw Unsupported(person, "native object-use stack boundaries are inconsistent");
+                if (use.TargetID == 0 || VM.GetObjectById(use.TargetID) == null)
+                    throw Unsupported(person, "a native object-use target is missing: " + use.TargetID);
+                previousDepth = use.StackLength;
+            }
+            var activeCount = saved.ActiveInteraction.IsValid ? 1 : 0;
+            if (person.Thread.Queue.Count != activeCount + saved.QueuedInteractions.Count
+                || person.Thread.ActiveQueueBlock != activeCount - 1)
+                throw Unsupported(person, "the imported queue no longer matches the captured native interactions");
+            for (var i = 0; i < saved.QueuedInteractions.Count; i++)
+                if (person.Thread.Queue[activeCount + i].UID != unchecked((ushort)saved.QueuedInteractions[i].UID))
+                    throw Unsupported(person, "the native queued interaction order changed before recovery");
+            if (activeCount != 0 && person.Thread.Queue[0].UID != unchecked((ushort)saved.ActiveInteraction.UID))
+                throw Unsupported(person, "the native active interaction changed before recovery");
+            // Stage all people during the caller's preflight. Later callbacks
+            // may legitimately change their live queues before their own reset.
+            People.Add(person.ObjectID, new PersonState(person, saved));
+        }
+
+        private PersonState State(VMAvatar person)
+        {
+            PersonState state;
+            if (!People.TryGetValue(person.ObjectID, out state))
+            {
+                state = new PersonState(person, Plan.GetPersonState(person.ObjectID));
+                People.Add(person.ObjectID, state);
+            }
+            return state;
+        }
+
+        public bool DoesRequireFullReset(VMAvatar person, VMEntity target)
+        {
+            if (target == null) return true;
+            Validate(person);
+            var state = State(person);
+            // 0045e974 compares the raw active icon, without testing TTA validity.
+            return state.ActiveIcon == target.ObjectID
+                || state.Uses.Any(use => use.TargetID == target.ObjectID);
+        }
+
+        public void ResetSelf(VMAvatar person)
+        {
+            if (person != null && Resetting.Contains(person.ObjectID)) return;
+            Validate(person);
+            if (!Resetting.Add(person.ObjectID)) return; // native +114 bit11
+            try
+            {
+                var state = State(person);
+                ResetExecution(person, state, person);
+                DiscardQueued(person, state, null);
+            }
+            finally { Resetting.Remove(person.ObjectID); }
+        }
+
+        public void Notify(VMAvatar person, VMEntity target)
+        {
+            if (target == null) { ResetSelf(person); return; }
+            if (person == target || person.Dead || Resetting.Contains(person.ObjectID)) return;
+            Validate(person);
+            if (!Resetting.Add(person.ObjectID)) return;
+            try
+            {
+                var state = State(person);
+                if (state.ActiveIcon == target.ObjectID || state.Uses.Any(use => use.TargetID == target.ObjectID))
+                    ResetExecution(person, state, target);
+                DiscardQueued(person, state, target);
+
+                // 0045ed67 onward clears last/active target or icon separately.
+                // LastInteraction has no runtime action slot, so retain its
+                // pointer state here for subsequent notifications in this import.
+                if (state.LastTarget == target.ObjectID) state.LastTarget = state.LastIcon = 0;
+                else if (state.LastIcon == target.ObjectID) state.LastIcon = 0;
+                if (state.ActiveTarget == target.ObjectID) ClearActive(person, state);
+                else if (state.ActiveIcon == target.ObjectID) SetActiveIcon(state, 0);
+            }
+            finally { Resetting.Remove(person.ObjectID); }
+        }
+
+        private void ResetExecution(VMAvatar person, PersonState state, VMEntity notificationTarget)
+        {
+            var cascade = SuppressReferencedObjectReset?.Invoke(notificationTarget) != true;
+            // 0045e980 unwinds each use in reverse order before notifying and
+            // resetting that referenced object. Do not execute obsolete frames.
+            while (state.Uses.Count != 0)
+            {
+                var use = state.Uses[state.Uses.Count - 1];
+                var referenced = VM.GetObjectById(use.TargetID);
+                while (person.Thread.Stack.Count >= use.StackLength)
+                {
+                    person.Thread.Stack.RemoveAt(person.Thread.Stack.Count - 1);
+                    AfterPop(person, state);
+                }
+                if (state.Uses.Contains(use)) AfterPop(person, state);
+                if (cascade && referenced != null && !referenced.Dead)
+                    ResetReferencedObject(referenced);
+                if (person.Dead) return;
+            }
+
+            ResetController(person);
+            RepairPlacement(person);
+            if (person.Dead) return;
+
+            // Main restart keeps the same thread and its temporary registers.
+            // Old routing frames and asynchronous ownership cannot survive it.
+            var thread = person.Thread;
+            thread.Stack.Clear();
+            thread.BlockingState = null;
+            if (thread.EODConnection != null) VM.EODHost?.ForceDisconnect(person);
+            thread.EODConnection = null;
+            thread.Interrupt = false;
+            thread.ThreadBreak = VMThreadBreakMode.Active;
+            VM.Scheduler.DescheduleTick(person);
+            VM.Scheduler.ScheduleTickIn(person, 1);
+            person.ExecuteEntryPoint(1, VM.Context, false);
+            person.ExecuteEntryPoint(3, VM.Context, true); // includes human Sims
+            person.SetPersonData(VMPersonDataVariable.Posture, 0);
+            person.SetPersonData(VMPersonDataVariable.WalkingUpStairs, 0);
+            person.SetPersonData(VMPersonDataVariable.InteractionStatus, 0);
+            person.SetValue(VMStackObjectVariable.Hidden, 0);
+            person.SetValue(VMStackObjectVariable.RoutePrefference, 0);
+            ClearActive(person, state);
+        }
+
+        private void AfterPop(VMAvatar person, PersonState state)
+        {
+            // 0045e769: process native object-use records crossed by this pop.
+            if (state.Uses.Count != 0 && person.Thread.Stack.Count < state.Uses[state.Uses.Count - 1].StackLength)
+            {
+                var last = state.Uses[state.Uses.Count - 1];
+                if (person.Thread.Stack.Count == last.StackLength - 1)
+                    foreach (var use in state.Uses)
+                        if (use.Unknown2 != 0) SetActiveIcon(state, use.TargetID);
+                state.Uses.RemoveAt(state.Uses.Count - 1);
+                var referenced = VM.GetObjectById(last.TargetID);
+                if (referenced?.ObjectData != null && referenced.ObjectData.Length > (int)VMStackObjectVariable.UseCount)
+                    referenced.ObjectData[(int)VMStackObjectVariable.UseCount]--;
+
+                // Simitone computes UseCount from active queue ownership instead
+                // of native use records. Release that ownership when its last
+                // callee use is crossed, without sending queued-drop EP4.
+                if (state.ActiveAction?.Callee == referenced
+                    && !state.Uses.Any(use => use.TargetID == last.TargetID))
+                    person.Thread.ActiveQueueBlock = -1;
+            }
+            if (state.Uses.Count == 0) ClearActive(person, state);
+        }
+
+        private void SetActiveIcon(PersonState state, short objectID)
+        {
+            state.ActiveIcon = objectID;
+            if (state.ActiveAction != null) state.ActiveAction.IconOwner = VM.GetObjectById(objectID);
+        }
+
+        private void ClearActive(VMAvatar person, PersonState state)
+        {
+            var hadTarget = state.ActiveTarget != 0;
+            if (state.ActiveAction != null)
+            {
+                RemoveAction(person.Thread, state.ActiveAction);
+                state.ActiveAction = null;
+            }
+            state.ActiveTarget = state.ActiveIcon = 0;
+            if (hadTarget)
+            {
+                person.SetPersonData(VMPersonDataVariable.MultipleRoutes, 0);
+                person.SetPersonData(VMPersonDataVariable.RoutingComplete, 0);
+            }
+            person.SetPersonData(VMPersonDataVariable.Priority, 0);
+            person.ClearMotiveChanges();
+            person.SetPersonData(VMPersonDataVariable.NonInterruptable, 0);
+            person.SetPersonData(VMPersonDataVariable.RouteFootprintMask, 0);
+            var extended = person.GetPersonData(VMPersonDataVariable.FootprintExtension) != 0;
+            person.SetPersonData(VMPersonDataVariable.FootprintExtension, 0);
+            if (extended) person.UpdateFootprint();
+        }
+
+        private static void RemoveAction(VMThread thread, VMQueuedAction action)
+        {
+            var index = thread.Queue.IndexOf(action);
+            if (index < 0) return;
+            thread.Queue.RemoveAt(index);
+            if (index <= thread.ActiveQueueBlock) thread.ActiveQueueBlock--;
+            thread.QueueDirty = true;
+        }
+
+        private void DiscardQueued(VMAvatar person, PersonState state, VMEntity target)
+        {
+            // Remove before EP4: callbacks can mutate the queue. Re-scan the
+            // live queue to preserve survivor order and include callback changes.
+            while (true)
+            {
+                var action = person.Thread.Queue.FirstOrDefault(item => item != state.ActiveAction
+                    && (target == null || item.Callee == target || item.IconOwner == target));
+                if (action == null) return;
+                RemoveAction(person.Thread, action);
+                if (action.Callee != null && !action.Callee.Dead)
+                    action.Callee.ExecuteEntryPoint(4, VM.Context, true, person);
+            }
+        }
+
+        private void ResetController(VMAvatar person)
+        {
+            // The engine represents native controller/animation state through
+            // animation lists, transient accessories, a skeleton and outfits.
+            // Refresh those using their existing APIs, retaining saved appearance
+            // and all motive/personality banks rather than re-running avatar Init.
+            person.Animations.Clear();
+            person.CarryAnimationState = null;
+            person.VisualPositionStart = null;
+            person.Velocity = Vector3.Zero;
+            person.TurnVelocity = 0;
+            person.SetObstacleStatic(true);
+            person.SetPersonData(VMPersonDataVariable.CensorshipFlags, 0);
+            person.SetPersonData(VMPersonDataVariable.HandGestureLeft, 0);
+            person.SetPersonData(VMPersonDataVariable.HandGestureRight, 0);
+            if (person.Headline != null)
+            {
+                person.HeadlineRenderer?.Dispose();
+                person.Headline = null;
+                person.HeadlineRenderer = null;
+            }
+            if (FSO.SimAntics.VM.UseWorld && person.Avatar != null)
+            {
+                foreach (var name in person.BoundAppearances)
+                {
+                    var appearance = FSO.Content.Content.Get().AvatarAppearances.Get(name);
+                    if (appearance != null) person.Avatar.RemoveAccessory(appearance);
+                }
+                person.Avatar.Skeleton = person.Avatar.BaseSkeleton.Clone();
+                person.Avatar.ReloadSkeleton();
+                person.Avatar.LeftHandGesture = SimHandGesture.Idle;
+                person.Avatar.RightHandGesture = SimHandGesture.Idle;
+            }
+            person.BoundAppearances.Clear();
+            var gender = person.GetPersonData(VMPersonDataVariable.Gender);
+            person.InitBodyData(VM.Context);
+            person.SetPersonData(VMPersonDataVariable.Gender, gender);
+            var body = person.BodyOutfit;
+            var head = person.HeadOutfit;
+            var skin = person.SkinTone;
+            if (body != null) person.BodyOutfit = body; // setters refresh meshes
+            if (head != null) person.HeadOutfit = head;
+            person.SkinTone = skin;
+        }
+
+        private void RepairPlacement(VMAvatar person)
+        {
+            // Native leaves an ordinary in-world standing person in place. A
+            // contained person is detached to the same position; an out-of-world
+            // person searches from the lot centre. Probe with PositionValid:
+            // rejected SetPosition attempts would run rollback Placement/EP9.
+            if (person.Container == null && person.Position != LotTilePos.OUT_OF_WORLD) return;
+            var origin = person.Position;
+            var direction = person.Direction;
+            if (person.Container != null)
+            {
+                person.ExecuteEntryPoint(10, VM.Context, true);
+                if (person.Dead) return;
+            }
+            if (origin == LotTilePos.OUT_OF_WORLD || VM.Context.IsOutOfBounds(origin))
+                origin = LotTilePos.FromBigTile((short)(VM.Context.Architecture.Width / 2),
+                    (short)(VM.Context.Architecture.Height / 2), 1);
+            var preferredRoom = VM.Context.GetRoomAt(origin);
+            LotTilePos? chosen = null;
+            var limit = Math.Max(VM.Context.Architecture.Width, VM.Context.Architecture.Height);
+            // Native 00434895 first keeps the origin's room, then relaxes that
+            // constraint. Collision/EP5 checks remain the engine's own policy.
+            for (var pass = 0; pass < 2 && !chosen.HasValue && !person.Dead; pass++)
+            {
+                foreach (var candidate in PlacementCandidates(origin, limit))
+                {
+                    if (VM.Context.IsOutOfBounds(candidate)) continue;
+                    var sameRoom = VM.Context.GetRoomAt(candidate) == preferredRoom;
+                    if (pass == 0 && !sameRoom) continue;
+                    var result = person.PositionValid(candidate, direction, VM.Context, VMPlaceRequestFlags.Default);
+                    if (person.Dead) return;
+                    if (result.Status != VMPlacementError.Success) continue;
+                    chosen = candidate;
+                    break;
+                }
+            }
+            if (person.Dead) return;
+            if (!chosen.HasValue)
+                throw new InvalidOperationException("TS1 person recovery found no legal position for avatar " + person.ObjectID);
+
+            // Commit exactly once after selection. A callback may have changed
+            // placement legality since the probe; report that failure directly.
+            var placement = person.SetPosition(chosen.Value, direction, VM.Context);
+            if (placement.Status != VMPlacementError.Success)
+                throw new InvalidOperationException("TS1 person recovery could not commit the selected position for avatar "
+                    + person.ObjectID + ": " + placement.Status);
+            if (person.Dead) return;
+            if (person.Position != LotTilePos.OUT_OF_WORLD)
+                person.SetPersonData(VMPersonDataVariable.IsSwimming,
+                    (short)(VM.Context.Architecture.GetPreciseFloor(person.Position) == ushort.MaxValue ? 1 : 0));
+        }
+
+        private static IEnumerable<LotTilePos> PlacementCandidates(LotTilePos origin, int limit)
+        {
+            yield return origin;
+            for (var radius = 1; radius < limit; radius++)
+                for (var y = -radius; y <= radius; y++)
+                    for (var x = -radius; x <= radius; x++)
+                    {
+                        if (Math.Abs(x) != radius && Math.Abs(y) != radius) continue;
+                        yield return LotTilePos.FromBigTile((short)(origin.TileX + x),
+                            (short)(origin.TileY + y), origin.Level);
+                    }
+        }
+    }
+}
diff --git a/TSOClient/tso.simantics/Utils/VMTS1PortalRecovery.cs b/TSOClient/tso.simantics/Utils/VMTS1PortalRecovery.cs
new file mode 100644
index 0000000..a1daede
--- /dev/null
+++ b/TSOClient/tso.simantics/Utils/VMTS1PortalRecovery.cs
@@ -0,0 +1,255 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using FSO.LotView.Model;
+using FSO.SimAntics.Entities;
+using FSO.SimAntics.Model;
+
+namespace FSO.SimAntics.Utils
+{
+    /// <summary>
+    /// Portal-specific bookends for the TS1 multi-part recovery sequence.
+    /// The caller still performs EP10, detach, reset, placement and EP9 for
+    /// every piece. This class reconciles the portal links and room obstacles
+    /// before detach and after the last piece has been placed.
+    /// </summary>
+    public static class VMTS1PortalRecovery
+    {
+        public sealed class Snapshot
+        {
+            internal VMMultitileGroup Group;
+            internal VMGameObject[] Members;
+            internal VMGameObject[] Portals;
+            internal short[] ObjectIDs;
+            internal short[] PortalObjectIDs;
+            internal ushort[] OldRooms;
+            internal sbyte[] OldLevels;
+            internal bool Detached;
+
+            public bool IsDetached => Detached;
+        }
+
+        /// <summary>
+        /// Capture immediately before the native portal detach override.
+        /// Also serves as a read-only preflight for the portal-specific state.
+        /// </summary>
+        public static Snapshot Capture(VM vm, VMGameObject target)
+        {
+            if (vm == null) throw new ArgumentNullException(nameof(vm));
+            if (target == null) throw new ArgumentNullException(nameof(target));
+            var context = vm.Context;
+            var group = target.MultitileGroup;
+            if (context == null || group == null || group.Objects == null
+                || group.Objects.Count == 0 || !group.Objects.Contains(target))
+                throw Unsupported(target, "missing portal group or context");
+
+            var members = group.Objects.OfType<VMGameObject>().ToArray();
+            if (members.Length != group.Objects.Count || members.Distinct().Count() != members.Length)
+                throw Unsupported(target, "portal group membership is inconsistent");
+            if (members.Any(piece => piece.EntryPoints == null || piece.EntryPoints.Length <= 15))
+                throw Unsupported(target, "a group piece has no portal entry-point table");
+            var portals = members.Where(piece => piece.Portal).ToArray();
+            if (portals.Length == 0)
+                throw Unsupported(target, "the group has no portal entry point");
+            if (context.RoomInfo == null || context.Architecture == null)
+                throw Unsupported(target, "room tables are unavailable");
+
+            var oldRooms = new ushort[portals.Length];
+            var oldLevels = new sbyte[portals.Length];
+            for (var i = 0; i < portals.Length; i++)
+            {
+                var piece = portals[i];
+                if (piece.Dead || piece.GhostImage || piece.Container != null
+                    || piece.Position == LotTilePos.OUT_OF_WORLD
+                    || piece.Position.Level < 1
+                    || piece.Position.Level > context.Architecture.Stories
+                    || piece.MultitileGroup != group)
+                    throw Unsupported(target, "a portal piece is not placed in the world");
+                oldRooms[i] = context.GetObjectRoom(piece);
+                oldLevels[i] = piece.Position.Level;
+                if (oldRooms[i] >= context.RoomInfo.Length
+                    || context.RoomInfo[oldRooms[i]].Portals == null)
+                    throw Unsupported(target, "a portal piece has no room table");
+            }
+
+            return new Snapshot
+            {
+                Group = group,
+                Members = members,
+                Portals = portals,
+                ObjectIDs = members.Select(piece => piece.ObjectID).ToArray(),
+                PortalObjectIDs = portals.Select(piece => piece.ObjectID).ToArray(),
+                OldRooms = oldRooms,
+                OldLevels = oldLevels
+            };
+        }
+
+        /// <summary>
+        /// Call before the group EP10 loop. Native cXPortal::+0x50 changes
+        /// portal topology before delegating to cXMTObject::+0x50. Physical
+        /// detach remains in the caller's normal per-piece sequence, so each
+        /// piece still receives PrePositionChange once after EP10.
+        /// </summary>
+        public static void BeforeDetach(VM vm, Snapshot snapshot)
+        {
+            Validate(vm, snapshot);
+            if (snapshot.Detached)
+                throw Unsupported(snapshot.Members[0], "portal detach was already started");
+            var rooms = OldRoomLevels(snapshot);
+            snapshot.Detached = true;
+            RemoveLinks(vm.Context, new HashSet<short>(snapshot.PortalObjectIDs), rooms);
+            RegenerateRoomObstacles(vm.Context, rooms);
+        }
+
+        /// <summary>
+        /// Call after the group's placement and EP9 loops. A piece registered
+        /// earlier may have observed its partner still out of world, so links
+        /// are reconstructed from the final positions of the whole group.
+        /// </summary>
+        public static void AfterRestore(VM vm, Snapshot snapshot)
+        {
+            Validate(vm, snapshot);
+            if (!snapshot.Detached)
+                throw Unsupported(snapshot.Members[0], "portal detach was not started");
+            var context = vm.Context;
+            var rooms = OldRoomLevels(snapshot);
+            RemoveLinks(context, new HashSet<short>(snapshot.PortalObjectIDs), rooms);
+            foreach (var piece in snapshot.Portals)
+            {
+                if (piece.Dead || piece.GhostImage || piece.Container != null
+                    || piece.Position == LotTilePos.OUT_OF_WORLD
+                    || piece.Position.Level < 1
+                    || piece.Position.Level > context.Architecture.Stories)
+                    throw Unsupported(piece, "a restored portal piece is not placed in the world");
+                var room = context.GetObjectRoom(piece);
+                if (room >= context.RoomInfo.Length)
+                    throw Unsupported(piece, "a restored portal piece has no room table");
+                rooms.Add(RoomLevel(room, piece.Position.Level));
+                context.AddRoomPortal(piece, room);
+            }
+            RegenerateRoomObstacles(context, rooms);
+            snapshot.Detached = false;
+        }
+
+        /// <summary>
+        /// Repair portal topology after an EP10/Init/EP9 callback deletes or
+        /// regroups a piece, or after the recovery sequence exits early.
+        /// Rebuild only the live groups reached from the original members;
+        /// never register a deleted or out-of-world piece as a portal.
+        /// </summary>
+        public static void Reconcile(VM vm, Snapshot snapshot)
+        {
+            if (vm == null) throw new ArgumentNullException(nameof(vm));
+            if (snapshot == null) throw new ArgumentNullException(nameof(snapshot));
+            if (!snapshot.Detached) return;
+            var context = vm.Context;
+            if (context == null || context.RoomInfo == null || context.Architecture == null)
+                throw Unsupported(snapshot.Members[0], "room tables are unavailable during portal reconciliation");
+
+            var rooms = OldRoomLevels(snapshot);
+            var sources = new HashSet<VMGameObject>();
+            foreach (var original in snapshot.Members)
+            {
+                if (!vm.Entities.Contains(original) || original.Dead) continue;
+                var group = original.MultitileGroup;
+                if (group == null || group.Objects == null) continue;
+                foreach (var member in group.Objects.OfType<VMGameObject>())
+                    if (IsLivePortal(vm, member)) sources.Add(member);
+            }
+
+            var ids = new HashSet<short>(snapshot.PortalObjectIDs);
+            foreach (var originalPortal in snapshot.Portals) ids.Add(originalPortal.ObjectID);
+            foreach (var source in sources) ids.Add(source.ObjectID);
+            RemoveLinks(context, ids, rooms);
+            foreach (var source in sources)
+            {
+                var room = context.GetObjectRoom(source);
+                if (room >= context.RoomInfo.Length || context.RoomInfo[room].Portals == null) continue;
+                rooms.Add(RoomLevel(room, source.Position.Level));
+                var group = source.MultitileGroup;
+                foreach (var other in group.Objects.OfType<VMGameObject>())
+                {
+                    if (other == source || !IsLivePortal(vm, other)) continue;
+                    var otherRoom = context.GetObjectRoom(other);
+                    if (otherRoom >= context.RoomInfo.Length || otherRoom == room) continue;
+                    context.RoomInfo[room].Portals.Add(new VMRoomPortal(source.ObjectID, otherRoom));
+                    break;
+                }
+            }
+            RegenerateRoomObstacles(context, rooms);
+            snapshot.Detached = false;
+        }
+
+        private static bool IsLivePortal(VM vm, VMGameObject piece)
+        {
+            return piece != null && vm.Entities.Contains(piece) && !piece.Dead && !piece.GhostImage
+                && piece.Container == null && piece.Position != LotTilePos.OUT_OF_WORLD
+                && piece.Position.Level >= 1
+                && piece.Position.Level <= vm.Context.Architecture.Stories
+                && piece.EntryPoints != null && piece.EntryPoints.Length > 15 && piece.Portal
+                && piece.MultitileGroup != null && piece.MultitileGroup.Objects != null;
+        }
+
+        private static void Validate(VM vm, Snapshot snapshot)
+        {
+            if (vm == null) throw new ArgumentNullException(nameof(vm));
+            if (snapshot == null) throw new ArgumentNullException(nameof(snapshot));
+            if (vm.Context == null || vm.Context.RoomInfo == null
+                || vm.Context.Architecture == null)
+                throw Unsupported(snapshot.Members[0], "room tables are unavailable");
+            if (snapshot.Group.Objects.Count != snapshot.Members.Length
+                || !snapshot.Group.Objects.SequenceEqual(snapshot.Members))
+                throw Unsupported(snapshot.Members[0], "portal group membership changed");
+            for (var i = 0; i < snapshot.Members.Length; i++)
+                if (snapshot.Members[i].MultitileGroup != snapshot.Group
+                    || snapshot.Members[i].ObjectID != snapshot.ObjectIDs[i])
+                    throw Unsupported(snapshot.Members[i], "portal piece identity changed");
+        }
+
+        private static void RemoveLinks(VMContext context, HashSet<short> ids,
+            HashSet<int> affectedRooms)
+        {
+            for (var room = 0; room < context.RoomInfo.Length; room++)
+            {
+                var links = context.RoomInfo[room].Portals;
+                if (links != null && links.RemoveAll(link => ids.Contains(link.ObjectID)) != 0)
+                    affectedRooms.Add(RoomLevel((ushort)room, (sbyte)(context.RoomInfo[room].Room.Floor + 1)));
+            }
+        }
+
+        private static HashSet<int> OldRoomLevels(Snapshot snapshot)
+        {
+            var rooms = new HashSet<int>();
+            for (var i = 0; i < snapshot.OldRooms.Length; i++)
+                rooms.Add(RoomLevel(snapshot.OldRooms[i], snapshot.OldLevels[i]));
+            return rooms;
+        }
+
+        private static int RoomLevel(ushort room, sbyte level)
+        {
+            return (room << 8) | (byte)level;
+        }
+
+        private static void RegenerateRoomObstacles(VMContext context, HashSet<int> rooms)
+        {
+            foreach (var pair in rooms)
+            {
+                var room = (ushort)(pair >> 8);
+                var level = (sbyte)(pair & 0xff);
+                if (room < context.RoomInfo.Length && level >= 1
+                    && level <= context.Architecture.Stories)
+                    context.RegenRoomObs(room, level);
+            }
+        }
+
+        private static NotSupportedException Unsupported(VMGameObject target, string reason)
+        {
+            return new NotSupportedException("TS1 portal recovery unsupported for entity "
+                + target.ObjectID + ": " + reason);
+        }
+    }
+}
diff --git a/TSOClient/tso.simantics/Utils/VMTS1PurchaseDiagnostics.cs b/TSOClient/tso.simantics/Utils/VMTS1PurchaseDiagnostics.cs
new file mode 100644
index 0000000..672b9eb
--- /dev/null
+++ b/TSOClient/tso.simantics/Utils/VMTS1PurchaseDiagnostics.cs
@@ -0,0 +1,100 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+using System;
+using System.Linq;
+using System.Text.Json;
+using FSO.SimAntics.Engine;
+using FSO.SimAntics.Entities;
+using FSO.SimAntics.NetPlay.Model.Commands;
+
+namespace FSO.SimAntics.Utils
+{
+    /// <summary>Read-only purchase/action observations on the simulation thread.</summary>
+    public static class VMTS1PurchaseDiagnostics
+    {
+        public static bool Enabled(VM vm) => vm.TS1
+            && Environment.GetEnvironmentVariable("ODH_VM_DIAGNOSTICS") == "1";
+
+        public static short[] ObjectIDs(VM vm) => Enabled(vm)
+            ? Capture(() => vm.Entities.Select(entity => entity.ObjectID).OrderBy(id => id).ToArray()) : null;
+
+        public static int? Budget(VM vm) => Enabled(vm) ? Capture<int?>(() => vm.TS1State.CurrentFamily?.Budget) : null;
+
+        public static void Charged(VM vm, VMNetBuyObjectCmd command, VMAvatar caller,
+            int value, int? before, int? after)
+        {
+            if (!Enabled(vm)) return;
+            Emit("TS1 purchase event: ", () => new
+            {
+                SchemaVersion = 1, Phase = "charged", command.GUID,
+                command.x, command.y, command.level,
+                Direction = (byte)command.dir, Mode = (byte)command.Mode,
+                Value = value, CallerObjectID = caller?.ObjectID, CallerPersistID = caller?.PersistID,
+                FamilyBudgetBefore = before, FamilyBudgetAfter = after
+            });
+        }
+
+        public static void Placed(VM vm, VMNetBuyObjectCmd command, VMAvatar caller,
+            int value, short[] beforeIDs, VMMultitileGroup group, bool success)
+        {
+            if (!Enabled(vm)) return;
+            Emit("TS1 purchase event: ", () => new
+            {
+                SchemaVersion = 1, Phase = "placed", command.GUID,
+                command.x, command.y, command.level,
+                Direction = (byte)command.dir, Mode = (byte)command.Mode,
+                Value = value, CallerObjectID = caller?.ObjectID, CallerPersistID = caller?.PersistID,
+                FamilyBudgetAfter = Budget(vm), PlacementSucceeded = success,
+                BeforeObjectIDs = beforeIDs,
+                Pieces = group?.Objects.Select(piece => new
+                {
+                    piece.ObjectID, GUID = piece.Object.OBJ.GUID, MasterGUID = piece.MasterDefinition?.GUID ?? 0,
+                    Position = new { piece.Position.x, piece.Position.y, piece.Position.Level },
+                    Direction = (byte)piece.Direction
+                }).ToArray()
+            });
+        }
+
+        public static void ActionStarted(VM vm, VMEntity actor, VMQueuedAction action)
+        {
+            if (!Enabled(vm)) return;
+            Emit("TS1 action started: ", () => new
+            {
+                SchemaVersion = 1, ActorObjectID = actor.ObjectID,
+                QueueUID = action.UID, ActionName = action.Name,
+                RoutineID = action.ActionRoutine?.ID, CalleeID = action.Callee?.ObjectID,
+                Tick = vm.Scheduler.CurrentTickID
+            });
+        }
+
+        private static T Capture<T>(Func<T> capture)
+        {
+            try { return capture(); }
+            catch (Exception error)
+            {
+                ReportFailure("TS1 purchase event: ", error);
+                return default(T);
+            }
+        }
+
+        private static void Emit(string prefix, Func<object> record)
+        {
+            try { Console.Error.WriteLine(prefix + JsonSerializer.Serialize(record())); }
+            catch (Exception error) { ReportFailure(prefix, error); }
+        }
+
+        private static void ReportFailure(string prefix, Exception error)
+        {
+            try
+            {
+                Console.Error.WriteLine(prefix + JsonSerializer.Serialize(new
+                {
+                    SchemaVersion = 1, DiagnosticError = error.GetType().Name
+                }));
+            }
+            catch (Exception) { /* Optional diagnostics must never interrupt gameplay. */ }
+        }
+    }
+}
diff --git a/TSOClient/tso.simantics/Utils/VMTS1SaveDiagnostics.cs b/TSOClient/tso.simantics/Utils/VMTS1SaveDiagnostics.cs
new file mode 100644
index 0000000..68179bc
--- /dev/null
+++ b/TSOClient/tso.simantics/Utils/VMTS1SaveDiagnostics.cs
@@ -0,0 +1,237 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+using System;
+using System.IO;
+using System.Linq;
+using System.Security.Cryptography;
+using System.Text.Json;
+using FSO.Files.Formats.IFF.Chunks;
+using FSO.LotView.Model;
+using FSO.SimAntics.Marshals;
+using FSO.SimAntics.Marshals.Threads;
+using FSO.SimAntics.Model.TS1Platform;
+
+namespace FSO.SimAntics.Utils
+{
+    /// <summary>
+    /// Opt-in save/load samples taken synchronously on the simulation owner
+    /// thread. No BHAV execution, resource loading, save writes or VM restore.
+    /// Component digests cover serialized fields omitted from the readable
+    /// projection (routing, animation, outfits, asynchronous state, architecture).
+    /// Never serialize the whole snapshot here: SIMI.Write is not read-only.
+    /// </summary>
+    public static class VMTS1SaveDiagnostics
+    {
+        private const string Prefix = "TS1 save state: ";
+
+        private static bool Enabled => Environment.GetEnvironmentVariable("ODH_VM_DIAGNOSTICS") == "1";
+
+        public static void Log(VM vm, string phase)
+        {
+            if (!Enabled || vm == null || !vm.TS1) return;
+            try { Log(vm.Save(), phase); }
+            catch (Exception error) { LogError(phase, error); }
+        }
+
+        public static void Log(VMMarshal snapshot, string phase, byte[] serializedPayload = null)
+        {
+            if (!Enabled || snapshot == null || !snapshot.TS1) return;
+            try
+            {
+                var platform = snapshot.PlatformState as VMTS1LotState;
+                var clock = snapshot.Context.Clock;
+                var architecture = snapshot.Context.Architecture;
+                var state = new
+                {
+                    Clock = new
+                    {
+                        clock.Ticks, clock.MinuteFractions, clock.TicksPerMinute,
+                        clock.Hours, clock.Minutes, clock.DayOfMonth, clock.Month, clock.Year,
+                        clock.FirePercent, clock.UTCStart
+                    },
+                    snapshot.Context.RandomSeed,
+                    AmbientBits = snapshot.Context.Ambience?.ActiveBits,
+                    Architecture = new
+                    {
+                        architecture.Width, architecture.Height, architecture.Stories,
+                        architecture.RoofStyle, architecture.RoofPitch, architecture.BuildBuyEnabled,
+                        BinarySHA256 = BinaryDigest(writer => architecture.SerializeInto(writer))
+                    },
+                    snapshot.GlobalState,
+                    NextObjectID = snapshot.ObjectId,
+                    Family = DescribeFamily(platform?.CurrentFamily),
+                    SIMI = DescribeSIMI(platform?.SimulationInfo),
+                    Entities = snapshot.Entities.Select((entity, index) => new { Entity = entity, Index = index })
+                        .OrderBy(item => item.Entity.ObjectID)
+                        .Select(item => DescribeEntity(item.Entity,
+                            item.Index < snapshot.Threads.Length ? snapshot.Threads[item.Index] : null)).ToArray(),
+                    EntityCount = snapshot.Entities.Length,
+                    ThreadCount = snapshot.Threads.Length,
+                    UnpairedThreads = snapshot.Threads.Skip(snapshot.Entities.Length)
+                        .Select(thread => BinaryDigest(writer => thread.SerializeInto(writer))).ToArray(),
+                    Groups = snapshot.MultitileGroups
+                        .OrderBy(group => group.Objects.Length == 0 ? short.MaxValue : group.Objects.Min())
+                        .Select(group => new
+                        {
+                            group.MultiTile, group.Name, group.Price, group.SalePrice, group.Objects,
+                            Offsets = group.Offsets.Select(Position).ToArray(),
+                            BinarySHA256 = BinaryDigest(writer => group.SerializeInto(writer))
+                        }).ToArray(),
+                    TuningSHA256 = snapshot.Tuning == null ? null
+                        : BinaryDigest(writer => snapshot.Tuning.SerializeInto(writer))
+                };
+                // Only primitive projections and scoped, read-only serializers
+                // participate. Do not call PlatformState.SerializeInto/SIMI.Write.
+                var stateBytes = JsonSerializer.SerializeToUtf8Bytes(state);
+                Console.Error.WriteLine(Prefix + JsonSerializer.Serialize(new
+                {
+                    SchemaVersion = 1,
+                    Phase = phase,
+                    SnapshotVersion = snapshot.Version,
+                    snapshot.Compressed,
+                    SerializedPayloadLength = serializedPayload?.Length,
+                    SerializedPayloadSHA256 = serializedPayload == null ? null : Digest(serializedPayload),
+                    StateSHA256 = Digest(stateBytes),
+                    RuntimeFamilySubset = platform?.CurrentFamily?.RuntimeSubset,
+                    State = state
+                }));
+            }
+            catch (Exception error) { LogError(phase, error); }
+        }
+
+        private static object DescribeEntity(VMEntityMarshal entity, VMThreadMarshal thread)
+        {
+            var avatar = entity as VMAvatarMarshal;
+            var gameObject = entity as VMGameObjectMarshal;
+            return new
+            {
+                Kind = avatar == null ? "object" : "avatar",
+                entity.ObjectID, entity.PersistID, entity.GUID, entity.MasterGUID,
+                Position = Position(entity.Position),
+                entity.ObjectData, entity.Attributes, entity.MyList,
+                entity.Container, entity.ContainerSlot, entity.Contained,
+                entity.MainParam, entity.MainStackOBJ,
+                entity.DynamicSpriteFlags, entity.DynamicSpriteFlags2,
+                entity.TimestampLockoutCount,
+                LightColor = entity.LightColor.PackedValue,
+                Relations = entity.MeToObject?.Select(relation => new { relation.Target, relation.Values }).ToArray(),
+                PersistRelations = entity.MeToPersist?.Select(relation => new { relation.Target, relation.Values }).ToArray(),
+                Direction = gameObject == null ? (byte?)null : (byte)gameObject.Direction,
+                Disabled = gameObject == null ? (byte?)null : (byte)gameObject.Disabled,
+                Avatar = avatar == null ? null : new
+                {
+                    avatar.PersonData, avatar.MotiveData,
+                    avatar.RadianDirection, avatar.HandObjectOld, avatar.KillTimeout,
+                    AnimationCount = avatar.Animations?.Length,
+                    HasCarryAnimation = avatar.CarryAnimationState != null,
+                    avatar.BoundAppearances,
+                    SkinTone = (byte)avatar.SkinTone,
+                    // BinarySHA256 below includes motives' fractional changes,
+                    // motive decay, outfits and every animation event/frame.
+                    MotiveChanges = avatar.MotiveChanges?.Select(change => new
+                    {
+                        Motive = (int)change.Motive, change.PerHourChange, change.MaxValue
+                    }).ToArray()
+                },
+                BinarySHA256 = BinaryDigest(writer => entity.SerializeInto(writer)),
+                Thread = DescribeThread(thread)
+            };
+        }
+
+        private static object DescribeThread(VMThreadMarshal thread)
+        {
+            if (thread == null) return null;
+            return new
+            {
+                thread.ActiveQueueBlock, thread.TempRegisters, thread.TempXL,
+                LastStackExitCode = (byte)thread.LastStackExitCode,
+                thread.Interrupt, thread.ActionUID, thread.DialogCooldown, thread.ScheduleIdleStart,
+                BlockingKind = thread.BlockingState?.GetType().Name,
+                HasEODConnection = thread.EODConnection != null,
+                Queue = thread.Queue.Select(action => new
+                {
+                    action.UID, action.RoutineID, action.CheckRoutineID,
+                    action.Callee, action.StackObject, action.IconOwner, action.CodeOwnerGUID,
+                    action.Args, action.InteractionNumber, action.NotifyIdle, action.Priority,
+                    Mode = (byte)action.Mode, Flags = (uint)action.Flags, Flags2 = (uint)action.Flags2,
+                    action.InteractionResult, action.ResultCheckCounter,
+                    HasCallback = action.Callback != null
+                }).ToArray(),
+                Stack = thread.Stack.Select(frame => new
+                {
+                    Kind = frame.GetType().Name,
+                    frame.RoutineID, frame.InstructionPointer,
+                    frame.Caller, frame.Callee, frame.StackObject, frame.CodeOwnerGUID,
+                    frame.Locals, frame.Args, frame.ActionTree,
+                    SpecialResult = (byte)frame.SpecialResult,
+                    BinarySHA256 = BinaryDigest(writer => frame.SerializeInto(writer))
+                }).ToArray(),
+                // Covers queues' names/callbacks, async/dialog state and all
+                // specialized routing/direct-control fields without traversing
+                // arbitrary engine objects through the JSON serializer.
+                BinarySHA256 = BinaryDigest(writer => thread.SerializeInto(writer))
+            };
+        }
+
+        private static object DescribeFamily(FAMI family)
+        {
+            if (family == null) return null;
+            return new
+            {
+                ID = family.ChunkID,
+                family.HouseNumber, family.FamilyNumber, family.Budget,
+                family.ValueInArch, family.FamilyFriends, family.Unknown, family.FamilyGUIDs
+                // RuntimeSubset is deliberately outside StateSHA256: FAMI.Write
+                // does not persist it. The frontend reactivates the whole family.
+            };
+        }
+
+        private static object DescribeSIMI(SIMI simi)
+        {
+            if (simi == null) return null;
+            return new
+            {
+                simi.Version, simi.GlobalData,
+                simi.Unknown1, simi.Unknown2, simi.Unknown3, simi.GUID1, simi.GUID2, simi.Unknown4,
+                simi.LotValue, simi.ObjectsValue, simi.ArchitectureValue,
+                BudgetDays = simi.BudgetDays?.Select(day => new
+                {
+                    day.Valid, day.MiscIncome, day.JobIncome, day.ServiceExpense,
+                    day.FoodExpense, day.BillsExpense, day.MiscExpense,
+                    day.HouseholdExpense, day.ArchitectureExpense
+                }).ToArray()
+            };
+        }
+
+        private static object Position(LotTilePos position)
+        {
+            return new { position.x, position.y, position.Level };
+        }
+
+        private static string BinaryDigest(Action<BinaryWriter> serialize)
+        {
+            using (var stream = new MemoryStream())
+            {
+                using (var writer = new BinaryWriter(stream, System.Text.Encoding.UTF8, true))
+                    serialize(writer);
+                return Digest(stream.ToArray());
+            }
+        }
+
+        private static string Digest(byte[] bytes)
+        {
+            return Convert.ToHexString(SHA256.HashData(bytes)).ToLowerInvariant();
+        }
+
+        private static void LogError(string phase, Exception error)
+        {
+            // Diagnostics must not turn a successful Save/Load into a failure.
+            Console.Error.WriteLine(Prefix + JsonSerializer.Serialize(new
+            {
+                SchemaVersion = 1, Phase = phase, DiagnosticError = error.GetType().Name
+            }));
+        }
+    }
+}
diff --git a/TSOClient/tso.simantics/Utils/VMTS1SavedCodeCompatibility.cs b/TSOClient/tso.simantics/Utils/VMTS1SavedCodeCompatibility.cs
new file mode 100644
index 0000000..06cb046
--- /dev/null
+++ b/TSOClient/tso.simantics/Utils/VMTS1SavedCodeCompatibility.cs
@@ -0,0 +1,207 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+using System;
+using System.Collections.Generic;
+using System.Collections.ObjectModel;
+using System.Linq;
+using System.Text.Json;
+using FSO.Content;
+using FSO.Files.Formats.IFF.Chunks;
+
+namespace FSO.SimAntics.Utils
+{
+    /// <summary>
+    /// Frozen per-type Init/Main signature comparisons for one native TS1 import.
+    /// Unsupported comparisons are distinct from compatible definitions.
+    /// </summary>
+    public sealed class VMTS1SavedCodeCompatibility
+    {
+        public const uint NativeAlwaysResetGuid = 0x3c08965f;
+
+        public sealed class TypeEntry
+        {
+            public uint GUID { get; }
+            public ushort TypeID { get; }
+            public string Name { get; }
+            public uint SavedInitSignature { get; }
+            public uint SavedMainSignature { get; }
+            public uint? CurrentInitSignature { get; }
+            public uint? CurrentMainSignature { get; }
+            public ushort? CurrentInitID { get; }
+            public ushort? CurrentMainID { get; }
+            public ushort? CurrentObjectVersion { get; }
+            public ushort? CurrentUsesFnTable { get; }
+            public string CurrentIffFilename { get; }
+            public string CurrentResourceName { get; }
+            public bool HasCurrentDefinition { get; }
+            public bool Known { get; }
+            public string UnsupportedReason { get; }
+            public bool Changed { get; }
+            public bool IsCursor { get; }
+            public string CursorClassification { get; }
+
+            internal TypeEntry(OBJTEntry saved, GameObject current, ushort? initID, ushort? mainID,
+                uint? initSignature, uint? mainSignature, string unsupportedReason)
+            {
+                GUID = saved.GUID;
+                TypeID = saved.TypeID;
+                Name = saved.Name;
+                SavedInitSignature = ((uint)saved.InitTreeVersion << 16) | saved.Unknown1a;
+                SavedMainSignature = ((uint)saved.MainTreeVersion << 16) | saved.Unknown2a;
+                CurrentInitID = initID;
+                CurrentMainID = mainID;
+                CurrentInitSignature = initSignature;
+                CurrentMainSignature = mainSignature;
+                CurrentObjectVersion = current?.OBJ?.ObjectVersion;
+                CurrentUsesFnTable = current?.OBJ?.UsesFnTable;
+                CurrentIffFilename = current?.Resource?.MainIff?.Filename;
+                CurrentResourceName = current?.Resource?.Name;
+                HasCurrentDefinition = current?.OBJ != null;
+                UnsupportedReason = unsupportedReason;
+                Known = HasCurrentDefinition && unsupportedReason == null && initSignature.HasValue && mainSignature.HasValue;
+                Changed = Known && (SavedInitSignature != initSignature.Value || SavedMainSignature != mainSignature.Value);
+                // Preserve the native special-type lookup rather than inferring it from OBJDType.
+                IsCursor = current?.OBJ?.GUID == NativeAlwaysResetGuid;
+                CursorClassification = IsCursor ? "native special-type lookup 0x0043e07d GUID 0x3c08965f" : null;
+            }
+        }
+
+        private readonly IReadOnlyDictionary<uint, TypeEntry> ByGUID;
+        private IReadOnlyDictionary<short, VMTS1SavedPersonRecoveryState> SavedPeople
+            = new ReadOnlyDictionary<short, VMTS1SavedPersonRecoveryState>(
+                new Dictionary<short, VMTS1SavedPersonRecoveryState>());
+        public IReadOnlyList<TypeEntry> Entries { get; }
+        public IReadOnlyDictionary<short, VMTS1SavedPersonRecoveryState> PersonStates => SavedPeople;
+        public int? SavedOBJTVersion { get; }
+        public int SavedTypeCount { get; }
+
+        public VMTS1SavedPersonRecoveryState GetPersonState(short objectID)
+        {
+            VMTS1SavedPersonRecoveryState state;
+            return SavedPeople.TryGetValue(objectID, out state) ? state : null;
+        }
+
+        internal void RegisterPersonState(short objectID, OBJMPerson person)
+        {
+            // Replace the map instead of exposing a live view of a mutable
+            // dictionary. Each snapshot and any previously obtained map stay fixed.
+            var updated = SavedPeople.ToDictionary(entry => entry.Key, entry => entry.Value);
+            updated.Add(objectID, new VMTS1SavedPersonRecoveryState(objectID, person));
+            SavedPeople = new ReadOnlyDictionary<short, VMTS1SavedPersonRecoveryState>(updated);
+        }
+
+        private VMTS1SavedCodeCompatibility(List<TypeEntry> entries, int? version, int savedTypeCount)
+        {
+            Entries = new ReadOnlyCollection<TypeEntry>(entries);
+            ByGUID = new ReadOnlyDictionary<uint, TypeEntry>(entries.ToDictionary(entry => entry.GUID));
+            SavedOBJTVersion = version;
+            SavedTypeCount = savedTypeCount;
+        }
+
+        public bool NeedsReset(VMEntity entity)
+        {
+            TypeEntry entry;
+            return entity?.Object?.OBJ != null && ByGUID.TryGetValue(entity.Object.OBJ.GUID, out entry)
+                && entry.Known && (entry.Changed || entry.IsCursor);
+        }
+
+        public bool CodeChanged(VMEntity entity)
+        {
+            TypeEntry entry;
+            return entity?.Object?.OBJ != null && ByGUID.TryGetValue(entity.Object.OBJ.GUID, out entry)
+                && entry.Known && entry.Changed;
+        }
+
+        private static GameIffResource Scope(VM vm, GameIffResource owner, ushort id)
+        {
+            if (id >= 8192) return owner?.SemiGlobal;
+            if (id >= 4096) return owner;
+            return vm.Context?.Globals?.Resource;
+        }
+
+        private static uint Signature(VM vm, GameIffResource owner, ushort rootID)
+        {
+            if (rootID == 0) return 0; // An absent action is valid, unlike a missing required root.
+            if (rootID < 256) throw new NotSupportedException("Entry point is not a BHAV ID: " + rootID);
+            Func<ushort, BHAV> resolve = id => Scope(vm, owner, id)?.Get<BHAV>(id);
+            if (resolve(rootID) == null) throw new NotSupportedException("Required root BHAV is absent: " + rootID);
+            return VMTS1CodeSignature.Compute(rootID, resolve);
+        }
+
+        public static VMTS1SavedCodeCompatibility Build(VM vm, OBJT table, int? version)
+        {
+            if (vm == null) throw new ArgumentNullException(nameof(vm));
+            if (table?.Entries == null) throw new ArgumentException("Native import requires an OBJT type table.", nameof(table));
+            var entries = new List<TypeEntry>();
+            var seen = new HashSet<uint>();
+            foreach (var saved in table.Entries)
+            {
+                if (saved.GUID == 0) continue; // Palette sentinel, not an object type.
+                if (!seen.Add(saved.GUID)) throw new NotSupportedException("Duplicate OBJT GUID cannot be planned unambiguously: " + saved.GUID);
+                GameObject current = null;
+                ushort? initID = null, mainID = null;
+                uint? initSignature = null, mainSignature = null;
+                string unsupported = null;
+                try
+                {
+                    current = Content.Content.Get().WorldObjects.Get(saved.GUID);
+                    if (current?.OBJ == null) unsupported = "missing_current_definition";
+                    else if (!version.HasValue || version.Value < 1) unsupported = "unsupported_OBJT_version:" + (version?.ToString() ?? "unavailable");
+                    else
+                    {
+                        var objd = current.OBJ;
+                        if (objd.UsesFnTable == 0)
+                        {
+                            initID = objd.BHAV_Init;
+                            mainID = objd.BHAV_MainID;
+                        }
+                        else
+                        {
+                            var functions = current.Resource?.Get<OBJf>(objd.ChunkID)?.functions;
+                            if (functions == null || functions.Length < 2)
+                                throw new NotSupportedException("Required OBJf Init/Main entries are absent.");
+                            initID = functions[0].ActionFunction;
+                            mainID = functions[1].ActionFunction;
+                        }
+                        initSignature = Signature(vm, current.Resource, initID.Value);
+                        mainSignature = Signature(vm, current.Resource, mainID.Value);
+                    }
+                }
+                catch (Exception e)
+                {
+                    unsupported = e.GetType().Name + ": " + e.Message;
+                }
+                entries.Add(new TypeEntry(saved, current, initID, mainID, initSignature, mainSignature, unsupported));
+            }
+            var plan = new VMTS1SavedCodeCompatibility(entries, version, table.Entries.Count);
+            plan.Log();
+            return plan;
+        }
+
+        /// <summary>Fail before VM.Load rather than importing execution with an unknown comparison.</summary>
+        public void Validate()
+        {
+            var unsupported = Entries.Where(entry => entry.HasCurrentDefinition && !entry.Known).ToArray();
+            if (unsupported.Length != 0)
+                throw new NotSupportedException("Native TS1 code compatibility preflight failed for " + unsupported.Length
+                    + " type(s): " + string.Join("; ", unsupported.Take(8).Select(entry => entry.GUID + " " + entry.UnsupportedReason)));
+        }
+
+        private void Log()
+        {
+            Console.Error.WriteLine("Saved code compatibility: " + JsonSerializer.Serialize(new
+            {
+                Kind = "summary", SavedOBJTVersion, AllTypes = SavedTypeCount, PlannedTypes = Entries.Count,
+                KnownTypes = Entries.Count(entry => entry.Known), MismatchedTypes = Entries.Count(entry => entry.Changed),
+                CursorTypes = Entries.Count(entry => entry.IsCursor),
+                UnsupportedTypes = Entries.Count(entry => entry.HasCurrentDefinition && !entry.Known),
+                MissingDefinitions = Entries.Count(entry => !entry.HasCurrentDefinition)
+            }));
+            var diagnostics = Environment.GetEnvironmentVariable("ODH_VM_DIAGNOSTICS") == "1";
+            foreach (var entry in diagnostics ? Entries : Entries.Where(entry => entry.HasCurrentDefinition && !entry.Known).Take(16))
+                Console.Error.WriteLine("Saved code compatibility: " + JsonSerializer.Serialize(new { Kind = "type", Entry = entry }));
+        }
+    }
+}
diff --git a/TSOClient/tso.simantics/Utils/VMTS1SavedCodeRecovery.cs b/TSOClient/tso.simantics/Utils/VMTS1SavedCodeRecovery.cs
new file mode 100644
index 0000000..7aabccb
--- /dev/null
+++ b/TSOClient/tso.simantics/Utils/VMTS1SavedCodeRecovery.cs
@@ -0,0 +1,164 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+using System;
+using System.Collections.Generic;
+using System.Linq;
+using System.Text.Json;
+using FSO.SimAntics.Model;
+
+namespace FSO.SimAntics.Utils
+{
+    /// <summary>
+    /// One native import's recovery state. Notifications visit other people;
+    /// nested resets retain the same entity IDs and do not run post-load Init.
+    /// The caller owns Load and the final family verification.
+    /// </summary>
+    public sealed class VMTS1SavedCodeRecovery
+    {
+        private readonly VM VM;
+        private readonly VMTS1SavedCodeCompatibility Plan;
+        private readonly VMTS1PersonRecovery People;
+        private readonly HashSet<short> Resetting = new HashSet<short>();
+
+        public VMTS1SavedCodeRecovery(VM vm, VMTS1SavedCodeCompatibility plan)
+        {
+            VM = vm ?? throw new ArgumentNullException(nameof(vm));
+            Plan = plan ?? throw new ArgumentNullException(nameof(plan));
+            People = new VMTS1PersonRecovery(vm, plan, entity => ResetEntity(entity, false));
+        }
+
+        public void Validate(IEnumerable<VMEntity> entities)
+        {
+            var visited = new HashSet<short>();
+            var unsupported = new List<string>();
+            // Every live person receives notifications, including people whose
+            // own code is compatible. Stage their metadata and referenced reset
+            // closure before any Load callback or recovery can mutate the VM.
+            foreach (var person in VM.Entities.OfType<VMAvatar>().Where(person => !person.Dead))
+                ValidateEntity(person, visited, unsupported);
+            foreach (var entity in entities)
+            {
+                if (entity.Dead || !Plan.NeedsReset(entity)) continue;
+                if (entity.Object?.OBJ?.GUID == VMTS1SavedCodeCompatibility.NativeAlwaysResetGuid)
+                    unsupported.Add("TS1 special-type recovery requires a dedicated adapter: " + entity.ObjectID);
+                ValidateEntity(entity, visited, unsupported);
+            }
+            if (unsupported.Count != 0)
+                throw new NotSupportedException("TS1 recovery preflight failed before migration:\n"
+                    + string.Join("\n", unsupported));
+        }
+
+        private void ValidateEntity(VMEntity target, HashSet<short> visited, List<string> unsupported)
+        {
+            if (target == null || target.Dead || !visited.Add(target.ObjectID)) return;
+            try
+            {
+                if (target is VMAvatar person)
+                {
+                    People.Validate(person);
+                    var state = Plan.GetPersonState(person.ObjectID);
+                    if (state != null)
+                        foreach (var use in state.ObjectUses)
+                            ValidateEntity(VM.GetObjectById(use.TargetID), visited, unsupported);
+                }
+                else
+                {
+                    var portal = CapturePortal(target);
+                    VMTS1ObjectRecovery.Validate(VM, target, true, true, portal != null);
+                }
+            }
+            catch (NotSupportedException error) { unsupported.Add(error.Message); }
+        }
+
+        public void RecoverAfterLoad(VMEntity target)
+        {
+            if (target != null && !target.Dead && Plan.NeedsReset(target))
+                ResetEntity(target, Plan.CodeChanged(target));
+        }
+
+        private VMTS1PortalRecovery.Snapshot CapturePortal(VMEntity target)
+        {
+            var obj = target as VMGameObject;
+            if (obj?.MultitileGroup?.Objects.Any(piece => piece.Portal) == true)
+                return VMTS1PortalRecovery.Capture(VM, obj);
+            return null;
+        }
+
+        private void NotifyOthers(VMEntity target)
+        {
+            foreach (var person in VM.Entities.OfType<VMAvatar>().ToArray())
+                if (person != target && !person.Dead) People.Notify(person, target);
+        }
+
+        private void ResetEntity(VMEntity target, bool postLoadInitialization)
+        {
+            if (target == null || target.Dead || !Resetting.Add(target.ObjectID)) return;
+            try
+            {
+                // 00444346 precedes the virtual reset and its position/data snapshots.
+                NotifyOthers(target);
+                if (target.Dead) return;
+                if (target is VMAvatar person)
+                {
+                    var diagnostic = Environment.GetEnvironmentVariable("ODH_VM_DIAGNOSTICS") == "1";
+                    var thread = person.Thread;
+                    var beforeData = diagnostic ? person.GetPersonDataClone() : null;
+                    var beforeMotives = diagnostic ? Enumerable.Range(0, 16)
+                        .Select(index => person.GetMotiveData((VMMotive)index)).ToArray() : null;
+                    var beforePosition = person.Position;
+                    var beforeQueue = person.Thread.Queue.Count;
+                    People.ResetSelf(person);
+                    if (diagnostic)
+                    {
+                        var afterData = person.GetPersonDataClone();
+                        Console.Error.WriteLine("Native person recovery: " + JsonSerializer.Serialize(new
+                        {
+                            ObjectID = person.ObjectID,
+                            SameInstance = ReferenceEquals(VM.GetObjectById(person.ObjectID), person),
+                            SameThread = ReferenceEquals(person.Thread, thread),
+                            BeforePosition = new { beforePosition.x, beforePosition.y, beforePosition.Level },
+                            AfterPosition = new { person.Position.x, person.Position.y, person.Position.Level },
+                            PersonWordCount = afterData.Length,
+                            ChangedPersonWords = Enumerable.Range(0, Math.Min(beforeData.Length, afterData.Length))
+                                .Where(index => beforeData[index] != afterData[index])
+                                .Select(index => new { Index = index, Before = beforeData[index], After = afterData[index] }).ToArray(),
+                            BeforeMotives = beforeMotives,
+                            AfterMotives = Enumerable.Range(0, 16).Select(index => person.GetMotiveData((VMMotive)index)).ToArray(),
+                            BeforeQueue = beforeQueue,
+                            AfterQueue = person.Thread.Queue.Count,
+                            NewUnresolvedFrames = person.Thread.Stack.Count(frame => frame.Routine == null)
+                        }));
+                    }
+                }
+                else
+                {
+                    var portal = CapturePortal(target);
+                    try
+                    {
+                        VMTS1ObjectRecovery.Apply(VM, target, true,
+                            notificationsHandled: true, postLoadInitialization: false,
+                            allowPortals: portal != null,
+                            beforeDetach: portal == null ? null : (Action)(() => VMTS1PortalRecovery.BeforeDetach(VM, portal)),
+                            afterRestore: portal == null ? null : (Action)(() => VMTS1PortalRecovery.AfterRestore(VM, portal)));
+                    }
+                    finally
+                    {
+                        // Callback deletion is not a rollback: rebuild topology
+                        // from the surviving pieces without resurrecting any.
+                        if (portal?.IsDetached == true) VMTS1PortalRecovery.Reconcile(VM, portal);
+                    }
+                }
+                if (postLoadInitialization && !target.Dead)
+                    target.ExecuteEntryPoint(0, VM.Context, true);
+                if (!target.Dead && target is VMGameObject obj)
+                {
+                    obj.RefreshGraphic();
+                    obj.RefreshLight();
+                }
+            }
+            finally { Resetting.Remove(target.ObjectID); }
+        }
+    }
+}
diff --git a/TSOClient/tso.simantics/Utils/VMTS1SavedPersonRecoveryState.cs b/TSOClient/tso.simantics/Utils/VMTS1SavedPersonRecoveryState.cs
new file mode 100644
index 0000000..bbd311d
--- /dev/null
+++ b/TSOClient/tso.simantics/Utils/VMTS1SavedPersonRecoveryState.cs
@@ -0,0 +1,101 @@
+// This Source Code Form is subject to the terms of the Mozilla Public
+// License, v. 2.0. If a copy of the MPL was not distributed with this
+// file, You can obtain one at https://mozilla.org/MPL/2.0/.
+
+using System;
+using System.Collections.Generic;
+using System.Collections.ObjectModel;
+using System.Linq;
+using FSO.Files.Formats.IFF.Chunks;
+
+namespace FSO.SimAntics.Utils
+{
+    /// <summary>
+    /// Immutable native person execution metadata, captured before conversion
+    /// expands object uses into frame callees and loses their boundaries.
+    /// This is evidence for recovery planning; it does not reset a person.
+    /// </summary>
+    public sealed class VMTS1SavedPersonRecoveryState
+    {
+        public sealed class ObjectUse
+        {
+            public short TargetID { get; }
+            public int StackLength { get; }
+            public byte Unknown2 { get; }
+
+            internal ObjectUse(OBJMObjectUse use)
+            {
+                TargetID = use.TargetID;
+                StackLength = use.StackLength;
+                Unknown2 = use.Unknown2;
+            }
+        }
+
+        public sealed class Interaction
+        {
+            public int UID { get; }
+            public short CallerID { get; }
+            public short TargetID { get; }
+            public short Icon { get; }
+            public int TTAIndex { get; }
+            public IReadOnlyList<short> Args { get; }
+            public int Priority { get; }
+            public short ActionTreeID { get; }
+            public float Attenuation { get; }
+            public OBJMInteractionFlags Flags { get; }
+            public bool IsValid => TTAIndex != -1;
+
+            internal Interaction(OBJMInteraction interaction)
+            {
+                UID = interaction.UID;
+                CallerID = interaction.CallerID;
+                TargetID = interaction.TargetID;
+                Icon = interaction.Icon;
+                TTAIndex = interaction.TTAIndex;
+                Args = interaction.Args == null ? null
+                    : Array.AsReadOnly((short[])interaction.Args.Clone());
+                Priority = interaction.Priority;
+                ActionTreeID = interaction.ActionTreeID;
+                Attenuation = interaction.Attenuation;
+                Flags = interaction.Flags;
+            }
+
+            /// <summary>
+            /// Native queued notification compares the interaction target and
+            /// icon only (0045ec57 onward), independently of queue flags.
+            /// </summary>
+            public bool ReferencesTarget(short targetID)
+            {
+                return targetID != 0 && (TargetID == targetID || Icon == targetID);
+            }
+        }
+
+        public short ObjectID { get; }
+        public IReadOnlyList<ObjectUse> ObjectUses { get; }
+        public Interaction ActiveInteraction { get; }
+        public Interaction LastInteraction { get; }
+        public IReadOnlyList<Interaction> QueuedInteractions { get; }
+
+        internal VMTS1SavedPersonRecoveryState(short objectID, OBJMPerson person)
+        {
+            ObjectID = objectID;
+            ObjectUses = new ReadOnlyCollection<ObjectUse>((person.ObjectUses ?? Array.Empty<OBJMObjectUse>())
+                .Select(use => new ObjectUse(use)).ToArray());
+            ActiveInteraction = new Interaction(person.ActiveInteraction);
+            LastInteraction = new Interaction(person.LastInteraction);
+            QueuedInteractions = new ReadOnlyCollection<Interaction>((person.InteractionQueue ?? Array.Empty<OBJMInteraction>())
+                .Select(interaction => new Interaction(interaction)).ToArray());
+        }
+
+        /// <summary>
+        /// Native non-null-target full reset selection (0045e953..0045e97a).
+        /// The active icon participates; the last interaction and arbitrary
+        /// frame stack objects do not. A null target uses the separate SELF path.
+        /// </summary>
+        public bool RequiresFullReset(short targetID)
+        {
+            return targetID != 0 && (ObjectUses.Any(use => use.TargetID == targetID)
+                || ActiveInteraction.Icon == targetID);
+        }
+    }
+}
diff --git a/TSOClient/tso.simantics/VM.cs b/TSOClient/tso.simantics/VM.cs
