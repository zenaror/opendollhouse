+            // TS1 mutates the family synchronously; its callback runs elsewhere.
+            VMTS1PurchaseDiagnostics.Charged(vm, this, caller, value, budgetBefore, VMTS1PurchaseDiagnostics.Budget(vm));
 
             return false;
         }
