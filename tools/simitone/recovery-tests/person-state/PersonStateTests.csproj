<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <SimitoneSourceRoot Condition="'$(SimitoneSourceRoot)' == ''">$(MSBuildThisFileDirectory)../../../../refs/work/Simitone-linux</SimitoneSourceRoot>
    <SimitoneRuntimeRoot Condition="'$(SimitoneRuntimeRoot)' == ''">$(MSBuildThisFileDirectory)../../../../build/simitone-linux</SimitoneRuntimeRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(SimitoneSourceRoot)/FreeSO/TSOClient/tso.simantics/Utils/VMTS1SavedPersonRecoveryState.cs" Link="VMTS1SavedPersonRecoveryState.cs" />
    <Reference Include="FSO.Files"><HintPath>$(SimitoneRuntimeRoot)/FSO.Files.dll</HintPath></Reference>
  </ItemGroup>
</Project>
