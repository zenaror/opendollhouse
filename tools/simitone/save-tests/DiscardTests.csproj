<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <SimitoneSourceRoot Condition="'$(SimitoneSourceRoot)' == ''">$(MSBuildThisFileDirectory)../../../refs/work/Simitone-linux</SimitoneSourceRoot>
    <SimitoneRuntimeRoot Condition="'$(SimitoneRuntimeRoot)' == ''">$(MSBuildThisFileDirectory)../../../build/simitone-linux</SimitoneRuntimeRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="DiscardProgram.cs" />
    <Compile Include="$(SimitoneSourceRoot)/FreeSO/TSOClient/tso.content/TS1/TS1ObjectProvider.cs" Link="TS1ObjectProvider.cs" />
    <Compile Include="$(SimitoneSourceRoot)/FreeSO/TSOClient/tso.content/TS1/TS1NeighbourProvider.cs" Link="TS1NeighbourProvider.cs" />
    <Reference Include="FSO.Content"><HintPath>$(SimitoneRuntimeRoot)/FSO.Content.dll</HintPath></Reference>
    <Reference Include="FSO.Files"><HintPath>$(SimitoneRuntimeRoot)/FSO.Files.dll</HintPath></Reference>
    <Reference Include="FSO.Common"><HintPath>$(SimitoneRuntimeRoot)/FSO.Common.dll</HintPath></Reference>
    <Reference Include="MonoGame.Framework"><HintPath>$(SimitoneRuntimeRoot)/MonoGame.Framework.dll</HintPath></Reference>
  </ItemGroup>
</Project>
